type: GenericCrafter
name: "Fluid Router"
description: "Receives and transports liquids."

buildVisibility: sandboxOnly
category: liquid
envEnabled: -1
requirements:[lead/20,copper/12, titanium/5]

rotate: true
enableDrawStatus: false

drawer:{
type: DrawMulti
drawers:[
{
type: DrawRegion
name: "gr-fluid-rail-bottom"
}
{
type: DrawLiquidTile
padding: 0.6
drawLiquid: liquid-copper
}
{
type: DrawLiquidTile
padding: 0.6
drawLiquid: liquid-lead
}
{
type: DrawLiquidTile
padding: 0.6
drawLiquid: liquid-silicon
}
{
type: DrawRegion
name: "gr-fluid-rail"
}
]
}

craftTime: 10

consumes:{
liquids:[
liquid-copper/0
liquid-lead/0
liquid-silicon/0
]
}

outputLiquids:[
liquid-copper/0
liquid-lead/0
liquid-silicon/0
]
