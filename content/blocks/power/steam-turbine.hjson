colorTo: 9f9fff00
length: 18
particles: 8
lifetime: 140
region: "gr-gas"
}
{
type: ParticleEffect
spin: 2.25
sozeFrom: 6
sizeTo: 8
colorFrom: 9f9fff
colorTo: 9f9fff00
length: 23
particles: 13
lifetime: 120
region: "gr-gas"
}
{
type: waveEffect
sizeFrom: 0
sizeTo: 36
lifetime: 16
strokeFrom: 6
strokeTo: 0
}
]
}

explosionShake: 6
customShadow: true

powerProduction: 12.5
maxHeat: 16
effectChance: 1
effect:{
type: RadialEffect
amount: 2
rotationOffset: 57.5
lengthOffset: 10
rotationSpacing: 65
effect:{
type: ParticleEffect
colorFrom: ffffff66
colorTo: ffffff00
length: 23
