type:  VariableReactor
name: Steam Turbine
size: 3

description: "
Produces power by condensing water into
steam and turning it into usable power.

[green]- Very reliable
- Lesser maintance
[red]- Explosive whilst active[]
"

requirements:[lead/235,copper/125,silicon/75,metaglass/75,oxide/45]
category: power

databaseTag: "adv-oxide"
envEnabled: -1

research: {
parent: photon-panel
research:[steam-turbine]
}

unstableSpeed: 0
explosionMinWarmup: 0.65
rebuildable: true

explosionPuddles: 0
